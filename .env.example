# Sesame Auth - Database Adapter Environment Variables
# Copy to .env and fill in your credentials

# ===========================================
# Postgres (use one of these)
# ===========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# POSTGRES_URL=postgresql://user:password@localhost:5432/mydb
# SESAME_DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# SESAME_POSTGRES_TABLE=sesame_agents

# ===========================================
# MongoDB (use one of these)
# ===========================================
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_URL=mongodb://localhost:27017
# SESAME_MONGODB_URI=mongodb://localhost:27017
# SESAME_MONGODB_DATABASE=sesame
# SESAME_MONGODB_COLLECTION=sesame_agents

# ===========================================
# Supabase
# ===========================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SESAME_SUPABASE_URL=https://your-project.supabase.co
# SESAME_SUPABASE_SERVICE_KEY=your-service-role-key
# SESAME_SUPABASE_TABLE=sesame_agents

# ===========================================
# Firebase
# ===========================================
# Path to service account JSON (Firebase uses this automatically)
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/serviceAccountKey.json
# GCLOUD_PROJECT=your-project-id
# FIREBASE_PROJECT_ID=your-project-id
# SESAME_FIREBASE_PROJECT_ID=your-project-id
# SESAME_FIREBASE_COLLECTION=sesame_agents
